.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .haystack_game,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0xa12d10ac19342e00, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.17.0",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        .websocket = .{ .path = "vendor/websocket", .lazy = true },
        .secp256k1 = .{
            .url = "https://github.com/bitcoin-core/secp256k1/releases/download/v0.8.0/libsecp256k1-0.8.0.tar.gz",
            .hash = "N-V-__8AAFwQbQAc-L8ZUw4rqyk_OWdYX4-V8crqiWlJ1dhl",
            .lazy = true,
        },
        .emsdk = .{
            .url = "git+https://github.com/emscripten-core/emsdk#4.0.9",
            .hash = "N-V-__8AAJl1DwBezhYo_VE6f53mPVm00R-Fk28NPW7P14EQ",
        },
        .raylib_zig = .{
            .url = "git+https://github.com/raylib-zig/raylib-zig?ref=devel#28bbe30112f605da918db00eff53a75ce1aa9180",
            .hash = "raylib_zig-6.2.0-KE8RELGmBQDX1v1DqBN57pNxJ-b-MIa1S-M7NXT9Eplr",
        },
    },
    // Build, runtime and regression-test inputs for both platform graphs.
    // Browser/vendor trees are explicit: their multi-gigabyte Cargo targets
    // and local tools/caches must never become package contents.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "build-support/bootstrap.py",
        "build-support/check_dependency_pins.py",
        "build-support/check_package.py",
        "build-support/ensure-emsdk.py",
        "build-support/install-zig.py",
        "build-support/macos-preflight.py",
        "build-support/native_tools.py",
        "build-support/run-browser-tests.py",
        "build-support/test_bootstrap.py",
        "build-support/test_browser_runner.py",
        "build-support/test_ci_workflow.py",
        "build-support/test_package.py",
        "build-support/test_dependency_pins.py",
        "build-support/test_graphs.py",
        "build-support/test_install_zig.py",
        "build-support/test_macos_preflight.py",
        "build-support/test_native_tools.py",
        "README.md",
        ".github/workflows/ci.yml",
        "src",
        "assets",
        "shared",
        "server",
        "docs",
        "browser/index.html",
        "browser/app.js",
        "browser/game-shell.html",
        "browser/game-ui.js",
        "browser/game-storage.js",
        "browser/game-storage-test.mjs",
        "browser/game-onboarding.js",
        "browser/game-onboarding-test.mjs",
        "browser/cdp-runner.mjs",
        "browser/cdp-runner-test.mjs",
        "browser/onboarding-browser-test.mjs",
        "browser/wallet-ui-browser-test.mjs",
        "browser/withdrawal-ui-browser-test.mjs",
        "browser/platform-hardening-browser-test.mjs",
        "browser/onboarding-test.html",
        "browser/onboarding-test.js",
        "browser/onboarding-regression-test.mjs",
        "browser/test-support/fake-indexeddb.mjs",
        "browser/test-support/fake-indexeddb-test.mjs",
        "browser/wallet-store.js",
        "browser/wallet-store-test.mjs",
        "browser/wallet-integration.js",
        "browser/wallet-browser-test.mjs",
        "browser/spilman-negative.js",
        "browser/live-channels.js",
        "browser/test-faults.js",
        "browser/fault-scenarios.js",
        "browser/recovery.js",
        "browser/test-wallet.js",
        "browser/wallet-test.html",
        "browser/wallet/Cargo.toml",
        "browser/wallet/Cargo.lock",
        "browser/wallet/platform.js",
        "browser/wallet/src",
        "browser/wallet/tests",
        "vendor/cdk-wallet-ffi/Cargo.toml",
        "vendor/cdk-wallet-ffi/Cargo.lock",
        "vendor/cdk-wallet-ffi/README.md",
        "vendor/cdk-wallet-ffi/include",
        "vendor/cdk-wallet-ffi/src",
        "vendor/cdk-wallet-ffi/examples",
        "vendor/qrcodegen",
        "vendor/websocket",
    },
}
